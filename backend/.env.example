# ─────────────────────────────────────────────
# LabouRack Backend — Environment Variables
# Copy this to .env and fill in real values
# ─────────────────────────────────────────────

# App
APP_NAME="LabouRack API"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development        # development | production

# Server
HOST=127.0.0.1
PORT=8000

# ─── Database ────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./labourack.db

# ─── JWT Authentication ───────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Redis ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# OTP TTL in seconds (10 minutes)
OTP_TTL_SECONDS=600

# ─── Celery ──────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── CORS ────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── SMS / OTP Provider (mock in dev) ────────
SMS_PROVIDER=mock              # mock | twilio | msg91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Admin Credentials ───────────────────────
ADMIN_DEFAULT_ID=admin
ADMIN_DEFAULT_PASSWORD=admin123
